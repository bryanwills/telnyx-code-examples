# Telnyx API credentials — replace with your own values
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# Phone number used to send SMS summaries (E.164 format)
TELNYX_NUMBER=+1555XXXXXXXX

# Recipient for post-conference summary SMS (E.164 format)
SUMMARY_RECIPIENT=+1555XXXXXXXX

# Demo mode: true = no real calls/SMS, false = live Telnyx API calls
DEMO_MODE=true

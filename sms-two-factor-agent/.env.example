# Telnyx API credentials — replace with your own
TELNYX_API_KEY=your_telnyx_api_key_here

# Telnyx number to send SMS from (E.164 format)
TELNYX_FROM_NUMBER=+1555XXXXXXXX

# Demo mode toggle
# "true"  (default) — logs SMS to console, no real messages sent
# "false"         — sends real SMS via Telnyx API
DEMO_MODE=true

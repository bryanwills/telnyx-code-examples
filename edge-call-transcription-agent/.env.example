# Telnyx API key — used for Call Control REST (answer, transcription_start/stop, hangup)
# Get it from https://portal.telnyx.com/api-keys
TELNYX_API_KEY=your_telnyx_api_key_here

# LLM model for post-call summary (default: zai-org/GLM-5.2)
AI_MODEL=zai-org/GLM-5.2

# Telnyx number that sends the SMS summary (must have messaging enabled + 10DLC campaign attached)
SMS_FROM=+16282564655

# Recipient phone — where the post-call summary SMS is sent (E.164)
SMS_TO=+17177247292

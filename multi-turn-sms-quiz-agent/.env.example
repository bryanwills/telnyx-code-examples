TELNYX_API_KEY=KEY0123456789abcdef

# The deployed Edge function uses the [telnyx] binding for inference and SMS.
# TELNYX_API_KEY is used locally by the Telnyx Edge CLI for auth.
DEMO_MODE=true
PRODUCTION_MODE=false
SMS_TRANSPORT=demo
DEMO_FROM_NUMBER=+15557654321
DEMO_SENDER_NUMBER=+15551234567
MAX_QUESTIONS=5
MODEL=zai-org/GLM-5.2
